# Kopiere diese Datei nach ".env" fuer lokale Tests (niemals committen!)

ANTHROPIC_API_KEY=sk-ant-...

# Fuer die 3 Bildvorschlaege (OpenAI Bildgenerierung)
OPENAI_API_KEY=sk-...

# Fuer das Hosting der Bilder (KI-Vorschlaege + eigene Uploads), damit Ocoya sie per
# oeffentlicher URL abrufen kann. Kostenloser API-Key: https://api.imgbb.com/
IMGBB_API_KEY=...

TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

OCOYA_API_KEY=...
OCOYA_WORKSPACE_ID=...
# Komma-getrennt, z.B. "clh1,clh2,clh3" - siehe scripts/list_ocoya_resources.py
OCOYA_SOCIAL_PROFILE_IDS=

# Optional, Defaults siehe scripts/main.py
POLL_TIMEOUT_MINUTES=60
MAX_REGENERATIONS=4
MAX_IMAGE_REGENERATIONS=2
# Stunde (lokale Zeit), fuer die der Post am naechsten Tag eingeplant wird
POST_SCHEDULE_HOUR=10
POST_SCHEDULE_TIMEZONE=Europe/Berlin

# --- Taegliche vollautomatische Automatisierung (scripts/daily/) ---
# Siehe README-Abschnitt "Taegliche Automatisierung" fuer die Einrichtung pro Plattform.

# Bild- + Video-Hosting (Free-Tier reicht): https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Komma-getrennte Liste aktivierter Ziele, z.B.:
# instagram_feed,instagram_reel,facebook_feed,facebook_video,linkedin,linkedin_video,twitter,twitter_video,tiktok
ENABLED_PLATFORMS=

# Meta (Instagram + Facebook) - developers.facebook.com
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=

# LinkedIn - linkedin.com/developers (Token laeuft nach ca. 60 Tagen ab)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# X/Twitter - developer.x.com (OAuth 1.0a User Context, Read+Write)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# TikTok - developers.tiktok.com (Content Posting API)
TIKTOK_ACCESS_TOKEN=
# SELF_ONLY bis das App-Audit fuer oeffentliches Posten abgeschlossen ist
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
